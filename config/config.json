{
  "development": {
    "dialect": "postgres",
    "logging": false,
    "pool": {
      "min": 0,
      "max": 10,
      "idle": 30000,
      "evict": 2000,
      "acquire": 60000,
      "handleDisconnects": true
    },
    "omitNull": true,
    "benchmark": true,
    "define": {
      "paranoid": true,
      "timestamps": true,
      "underscored": true,
      "underscoredAll": true,
      "createdAt": "created_at",
      "updatedAt": "updated_at",
      "deletedAt": "deleted_at",
      "defaultScope": {
        "where": {
          "deleted_at": null
        },
        "attributes": {
          "exclude": ["deleted_at"]
        }
      }
    }
  },
  "staging": {
